# Kibana / Elasticsearch connection for the bankstr domain.
# Copy this file to `.env` and fill in REAL values. `.env` is gitignored — never commit it.
# Following the elasticsearch-authn skill: keep secrets in this file, never paste them into chat.

# Required. Base URL of your Kibana deployment.
# On Elastic Cloud the Elasticsearch URL is derived automatically by swapping ".kb." -> ".es.".
KIBANA_URL=https://kibana.bankstr.xyz

# Optional. Explicit Elasticsearch URL. REQUIRED for self-hosted / custom-domain
# deployments (e.g. bankstr.xyz on your own infra) where Kibana and Elasticsearch
# are on different hosts/ports and the Cloud ".kb." -> ".es." convention does not apply.
# ELASTICSEARCH_URL=https://es.bankstr.xyz:9200

# Required. Base64-encoded API key (the `encoded` value returned by POST /_security/api_key).
# Prefer a scoped, expiring API key over the `elastic` superuser (see elasticsearch-authn skill).
KIBANA_API_KEY=

# Optional. Comma-separated glob patterns restricting which indices are reachable. Empty = unrestricted.
# ALLOWED_INDEX_PATTERNS=transactions-*,logs-*

# Optional tuning (defaults shown).
# MAX_SEARCH_SIZE=100
# REQUEST_TIMEOUT_MS=30000
# RETRY_ATTEMPTS=3
# RETRY_DELAY_MS=1000
# KIBANA_SPACE=
# AUDIT_ENABLED=true
# PII_REDACTION_ENABLED=true

# ---------------------------------------------------------------------------
# Remote endpoint (HTTP transport) — only needed when running `npm run start:http`
# or the Docker image. The stdio transport (dist/stdio.mjs) ignores these.
# ---------------------------------------------------------------------------

# REQUIRED for the HTTP endpoint. Bearer token that networked agents must present
# as `Authorization: Bearer <token>`. Generate a strong random secret, e.g.:
#   openssl rand -hex 32
# The server refuses to start without this (fail-closed) unless MCP_ALLOW_ANONYMOUS=true.
# MCP_AUTH_TOKEN=

# Escape hatch for LOCAL DEVELOPMENT ONLY — disables authentication. Never in production.
# MCP_ALLOW_ANONYMOUS=false

# HTTP bind + routes (defaults shown).
# HOST=0.0.0.0
# PORT=3000
# MCP_HTTP_PATH=/mcp        # modern streamable-HTTP transport
# MCP_SSE_PATH=/sse         # legacy SSE transport (client compatibility)
# MCP_MESSAGE_PATH=/message # legacy SSE client->server message path
